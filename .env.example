# ── 服务器连接 ────────────────────────────────
MC_HOST=127.0.0.1
MC_PORT=25565
MC_NAME=XiaoMai
MC_PW=            # nLogin 之类的登录插件用;绝不要提交真实密码
MC_FOLLOW_RANGE=2

# ── 大脑(决策模型)────────────────────────────
# 任何 Ollama 兼容的 /api/chat 端点都行。我们前面挂了一个网关,
# 它会在一台有独显的机器和三台 8GB 的 Mac 之间自动切换。
BRAIN_ENABLED=1
BRAIN_URL=http://127.0.0.1:11434/api/chat
BRAIN_MODEL=qwen3:8b
BRAIN_TIMEOUT_MS=60000
BRAIN_FLOOR_MS=2500        # 两次决策之间的最小间隔;太小会把本地模型打满,影响同机的其它 AI

# ── 规划师(给大目标拆步骤,频率低得多)──────────
PLAN_URL=http://127.0.0.1:11434/api/chat
PLAN_MODEL=qwen3:8b

# ── 主脑超时后的备用(自动降级,2 分钟后自动切回)──
BACKUP_URL=http://127.0.0.1:11434/api/chat
BACKUP_MODEL=qwen3:8b

# ── 角色(见 src/roles.json)──────────────────
ROLE=son

# ── 目标与护栏 ────────────────────────────────
GOAL_COUNT=64
GOAL_TEXT=做出箱子,把 64 块木头存进箱子
BUILD_RADIUS=24            # 只准在自己家这个半径内动土
HOME_MIN_DIST=80           # 家离出生点至少这么远(出生点一圈是保护区)
ALLOW_PLACE=0              # 全局逃生开关,平时保持 0
