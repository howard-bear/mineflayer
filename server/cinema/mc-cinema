import json
import os
import re
import shutil
import subprocess
import sys
import time
import uuid
import zipfile

PANEL = '/var/lib/mc-panel/cinema'          # 后台(mcpanel 账号)可写:设置、上传、缩略图、状态
SETTINGS = PANEL + '/cinema.json'
STATUS = PANEL + '/status.json'
UPLOADS = PANEL + '/uploads'
THUMBS = PANEL + '/thumbs'
ST = '/var/lib/mc-cinema'                    # 本程序自己的状态
CLIPS = ST + '/clips'                        # 转好的单段(minecraft 账号写)
MCC = '/opt/minecraft/plugins/MCCinema'
MEDIA = MCC + '/videos'                      # 轮播片放这儿(插件从这里读)
MCC_CFG = MCC + '/config.yml'
SCREEN = 'front'                             # 正面那块屏幕(墙在 z=46,画框 z=45 朝北对着出生点)
CHUNK_S = 5                                  # 声音每 5 秒一段
DITHER = {'fine': 'FLOYD_STEINBERG_REDUCED',  # 后台「画质」:清晰(用细小的彩色点混出颜色)
          'flat': 'NONE'}                     #              省网速(直接取最接近的颜色,会有色块)
RCON = '/usr/local/bin/mc-rcon'
LOCK = '/run/lock/mc-cinema.lock'

W, H = 896, 512                              # 屏幕 7×4 格,每格 128×128
MAX_DUR = 20 * 60                            # 单段最长用 20 分钟
FITS = {
    'pad': f'scale={W}:{H}:force_original_aspect_ratio=decrease:force_divisible_by=2:flags=lanczos,pad={W}:{H}:(ow-iw)/2:(oh-ih)/2:black',
    'crop': f'scale={W}:{H}:force_original_aspect_ratio=increase:flags=lanczos,crop={W}:{H}',
    'stretch': f'scale={W}:{H}:flags=lanczos',
}
ID_RE = re.compile(r'^[0-9a-f]{16}$')
AS_MC = ['setpriv', '--reuid=minecraft', '--regid=minecraft', '--clear-groups', 'nice', '-n', '15']


# ---------------- 小工具 ----------------
def now_hm():
    return time.strftime('%m-%d %H:%M')


def rcon(cmd):
    try:
        p = subprocess.run([RCON, cmd], capture_output=True, text=True, timeout=25)
        return re.sub('§.', '', (p.stdout or '') + (p.stderr or '')).strip()
    except Exception as e:
        return f'(rcon 出错 {e})'


def server_start():
    """服务器在跑就返回这次启动的时刻(单调时钟 µs),没在跑返回 None"""
    a = subprocess.run(['systemctl', 'is-active', 'minecraft'], capture_output=True, text=True).stdout.strip()
    if a != 'active':
        return None
    v = subprocess.run(['systemctl', 'show', 'minecraft', '-p', 'ActiveEnterTimestampMonotonic', '--value'],
                       capture_output=True, text=True).stdout.strip()
    return int(v) if v.isdigit() else None


def read_json(p, default):
    try:
        with open(p, encoding='utf-8') as f:
            return json.load(f)
    except Exception:
        return default


def write_json(p, obj, mode=0o644):
    tmp = p + '.tmp'
    with open(tmp, 'w', encoding='utf-8') as f:
        json.dump(obj, f, ensure_ascii=False, indent=1)
    os.chmod(tmp, mode)
    os.replace(tmp, p)


def read_text(p, default=''):
    try:
        with open(p, encoding='utf-8') as f:
            return f.read().strip()
    except Exception:
        return default


def write_text(p, s):
    with open(p + '.tmp', 'w', encoding='utf-8') as f:
        f.write(s + '\n')
    os.replace(p + '.tmp', p)


def video_id(name):
    """插件给每个视频文件起的编号(声音包里的声音名、缓存目录都用它)"""
    return re.sub(r'[^a-zA-Z0-9]', '_', name).lower()


# ---------------- 设置 ----------------
def load_settings():
    s = read_json(SETTINGS, {})
    out = {
        'rev': int(s.get('rev') or 0),
        'enabled': bool(s.get('enabled', True)),
        'audio': bool(s.get('audio', True)),
        'quality': s.get('quality') if s.get('quality') in DITHER else 'fine',
        'fps': min(20, max(1, int(s.get('fps') or 10))),
        'range': min(128, max(16, int(s.get('range') or 48))),
        'hours': {'on': bool((s.get('hours') or {}).get('on')),
                  'from': int((s.get('hours') or {}).get('from') or 0) % 24,
                  'to': int((s.get('hours') or {}).get('to') or 0) % 24},
        'items': [],
    }
    mu = s.get('music') or {}
    tracks = []
    for t in mu.get('tracks') or []:
        tid = str(t.get('id', ''))
        sec = float(t.get('sec') or 0)
        if re.match(r'^[a-z0-9_]{1,24}$', tid) and 5 <= sec <= 1200:
            tracks.append({'id': tid, 'sec': sec})
    out['music'] = {'on': bool(mu.get('on')), 'range': min(64, max(8, int(mu.get('range') or 48))), 'tracks': tracks}
    for it in s.get('items') or []:
        if not ID_RE.match(str(it.get('id', ''))):
            continue
        out['items'].append({
            'id': it['id'],
            'title': str(it.get('title') or '')[:60],
            'enabled': bool(it.get('enabled', True)),
            'repeat': min(10, max(1, int(it.get('repeat') or 1))),
            'fit': it.get('fit') if it.get('fit') in FITS else 'pad',
        })
    return out


def in_hours(s):
    h = s['hours']
    if not h['on'] or h['from'] == h['to']:
        return True
    hr = time.localtime().tm_hour
    if h['from'] < h['to']:
        return h['from'] <= hr < h['to']
    return hr >= h['from'] or hr < h['to']


# ---------------- 状态(给后台看) ----------------
def load_status():
    st = read_json(STATUS, {})
    st.setdefault('clips', {})
    st.setdefault('log', [])
    return st


def save_status(st, msg=None):
    if msg:
        st['log'] = (st.get('log') or [])[-29:] + [f'{now_hm()} {msg}']
        print(msg, flush=True)
    st['updated'] = int(time.time())
    write_json(STATUS, st)


# ---------------- 插件配置:收画面范围(要重启服务器才生效) ----------------
def cfg_range():
    m = re.search(r'^\s+viewer-distance:\s*(\d+)', read_text(MCC_CFG), re.M)
    return int(m.group(1)) if m else None


def cfg_apply_range(rng):
    with open(MCC_CFG, 'r+', encoding='utf-8') as f:        # 原地改(不换文件、不改属主)
        t = f.read()
        t2 = re.sub(r'^(\s+viewer-distance:\s*)\d+', rf'\g<1>{rng}', t, flags=re.M)
        if t2 != t:
            f.seek(0)
            f.write(t2)
            f.truncate()
            return True
    return False


def live_values(start):
    """这次服务器启动时生效的值(收画面范围、进服声音包):每次新启动的第一次 tick 记一份"""
    lv = read_json(ST + '/live.json', {})
    if start and lv.get('start') != start:
        lv = {'start': start, 'range': cfg_range(), 'packSha1': server_pack()[1]}
        write_json(ST + '/live.json', lv)
    return lv


# ---------------- 进服声音包(Owner 10-12 定:声音包在进服时一次给,游戏里不再中途加载) ----------------
PACK_DIR = ST + '/pack'                      # nginx 在 /etc/mc-cinema.conf 写的地址上提供这个目录
SERVER_PROPS = '/opt/minecraft/server.properties'
PACK_ID = str(uuid.uuid5(uuid.NAMESPACE_URL, 'yangyang-spawn-cinema-sound'))   # 固定编号:客户端按它替换旧包
PACK_PROMPT = '出生广场大屏的声音包(几 MB):点「是」,在大屏前就能听到视频原声;选「否」也能正常玩,只是大屏没声音。'


def pack_url_base():
    for line in read_text('/etc/mc-cinema.conf').splitlines():
        if line.startswith('PACK_URL_BASE='):
            return line.split('=', 1)[1].strip().rstrip('/') + '/'
    return ''


def build_login_pack(zips):
    """把插件给每段视频生成的声音包(mcc_audio_*.zip)合成一个进服声音包。
    同样的内容 → 同样的字节(固定文件顺序和时间)→ 同样的校验码,客户端不会重复下载。返回 (文件名, sha1, 声音段数)"""
    sounds, files = {}, {}
    for z in zips:
        with zipfile.ZipFile(z) as zf:
            for n in zf.namelist():
                if n == 'assets/mcc/sounds.json':
                    sounds.update(json.loads(zf.read(n)))
                elif n.startswith('assets/mcc/sounds/') and n.endswith('.ogg'):
                    files[n] = zf.read(n)
    os.makedirs(PACK_DIR, exist_ok=True)
    tmp = PACK_DIR + '/.building.zip'
    meta = {'pack': {'pack_format': 46, 'description': '羊羊出生广场大屏 · 视频原声'}}
    with zipfile.ZipFile(tmp, 'w') as zo:
        def put(name, data, comp):
            zi = zipfile.ZipInfo(name, date_time=(1980, 1, 1, 0, 0, 0))
            zi.compress_type = comp
            zi.external_attr = 0o644 << 16
            zo.writestr(zi, data)
        put('pack.mcmeta', json.dumps(meta, ensure_ascii=False, sort_keys=True).encode(), zipfile.ZIP_DEFLATED)
        put('assets/mcc/sounds.json', json.dumps(sounds, ensure_ascii=False, sort_keys=True, indent=1).encode(), zipfile.ZIP_DEFLATED)
        for n in sorted(files):
            put(n, files[n], zipfile.ZIP_STORED)     # ogg 本来就压缩过
    sha1 = hashlib.sha1(open(tmp, 'rb').read()).hexdigest()
    name = f'yangcinema-{sha1[:12]}.zip'
    os.chmod(tmp, 0o644)
    os.replace(tmp, os.path.join(PACK_DIR, name))
    return name, sha1, len(sounds)


def props_escape(text):
    return ''.join(c if ord(c) < 128 else '\\u%04x' % ord(c) for c in text)


def set_server_pack(name, sha1):
    """把进服声音包写进 server.properties(原地改,不换文件;下次重启生效)。name 为空 = 不给声音包"""
    url = (pack_url_base() + name) if name else ''
    prompt = props_escape(json.dumps({'text': PACK_PROMPT, 'color': 'yellow'}, ensure_ascii=False)) if name else ''
    want = {'resource-pack': url, 'resource-pack-sha1': sha1 if name else '', 'resource-pack-id': PACK_ID if name else '',
            'resource-pack-prompt': prompt, 'require-resource-pack': 'false'}
    with open(SERVER_PROPS, 'r+', encoding='utf-8') as f:
        lines = f.read().split('\n')
        seen = set()
        for i, ln in enumerate(lines):
            k = ln.split('=', 1)[0]
            if k in want:
                lines[i] = f'{k}={want[k]}'
                seen.add(k)
        for k in want:
            if k not in seen:
                lines.insert(len(lines) - 1 if lines and lines[-1] == '' else len(lines), f'{k}={want[k]}')
        new = '\n'.join(lines)
        f.seek(0)
        f.write(new)
        f.truncate()
    return url


def server_pack():
    """server.properties 里现在写的声音包(下次重启生效的那个)→ (地址, sha1)"""
    d = {}
    for ln in read_text(SERVER_PROPS).splitlines():
        if '=' in ln:
            k, v = ln.split('=', 1)
            d[k] = v
    return d.get('resource-pack', ''), d.get('resource-pack-sha1', '')


def update_login_pack(name, audio, st):
    """轮播片 name 的声音包 → 进服声音包;audio 关 → 不给声音包。写进 server.properties,重启后生效"""
    if not audio or not name:
        if server_pack()[0]:
            set_server_pack('', '')
            save_status(st, '视频原声关了:进服不再给声音包(重启后生效)')
        return
    z = os.path.join(MCC, f'mcc_audio_{video_id(name)}.zip')
    for _ in range(90):                                       # 插件开播时在后台提取声音、打包,最多等 3 分钟
        if os.path.isfile(z) and os.path.getsize(z) > 0 and time.time() - os.path.getmtime(z) > 2:
            break
        time.sleep(2)
    if not os.path.isfile(z):
        save_status(st, f'没等到插件给 {name} 生成声音包,下次再试')
        return
    pname, sha1, n = build_login_pack([z])
    if server_pack()[1] != sha1:
        set_server_pack(pname, sha1)
        save_status(st, f'进服声音包换成新的({n} 段声音,{os.path.getsize(os.path.join(PACK_DIR, pname)) // 1024} KB)—— 服务器重启后新视频才有声音')


# ---------------- 屏幕 ----------------
def mcc_info():
    """问插件屏幕现在什么状态 → (问到了没有, 状态 Playing/Paused/Idle/…, 正在放的文件)"""
    out = rcon(f'mcc info {SCREEN}')
    if 'Screen Info' not in out:
        return False, out[:100], None
    m = re.search(r'State:\s*(\w+)', out)
    v = re.search(r'Video:\s*(\S+)', out)
    return True, (m.group(1) if m else '?'), (v.group(1) if v else None)


def want_name(s):
    """应该放哪个文件:设置开着、清单不空才有"""
    if not s['enabled'] or os.path.exists(ST + '/OFF'):
        return None
    cur = read_text(ST + '/current')
    if cur and os.path.exists(os.path.join(MEDIA, cur)):
        return cur
    return None


def mount(name, s, st):
    """开播(插件会自己:附近没人就暂停、有人来了接着放、放完从头)"""
    flags = f'--audio {CHUNK_S} ' if s['audio'] else ''
    out = rcon(f'mcc play {SCREEN} {name} {flags}--dither {DITHER[s["quality"]]}')
    for _ in range(60):
        time.sleep(2)
        ok, state, video = mcc_info()
        if ok and video == name and state in ('Playing', 'Paused'):
            save_status(st, f'开播 {name}{"(带原声)" if s["audio"] else "(无声)"}' + ('' if s['quality'] == 'fine' else '(省网速画质)'))
            return True
    save_status(st, f'开播 {name} 没成:插件回话 {out[:80]};现在 {state} {video}')
    return False


def reconcile(s, st, start):
    """让屏幕和设置一致;返回现在在放的文件名(没在放返回 None)"""
    want = want_name(s)
    ok, state, video = mcc_info()
    if not ok:
        save_status(st, f'问插件没得到回话,这次不动屏幕:{state}')
        return None
    running = state in ('Playing', 'Paused', 'Loading')
    if not want or not in_hours(s):
        if running:
            rcon(f'mcc stop {SCREEN}')
            save_status(st, '停播' + ('(大屏关了或清单是空的)' if not want else '(不在播放时段)'))
        return None
    marker = f'{start}|{want}|{int(s["audio"])}|{s["quality"]}'
    if running and video == want and read_text(ST + '/mounted') == marker:
        return want
    if mount(want, s, st):
        write_text(ST + '/mounted', marker)
        return want
    return None


def front_screen():
    """插件存的 screens.yml 里正面那块屏幕:左下角 x/y、墙的 z、宽高(格)、朝向、每格的地图编号 {(列, 行): 编号}(第 0 行在最上面)。
    服务器上没有 yaml 库,这个文件格式固定,按行读。读不懂返回 None"""
    txt = read_text(MCC + '/screens.yml')
    for b in re.split(r'\n  (?=[0-9a-f-]{36}:\n)', txt):
        kv = dict(re.findall(r'^    (\w+): (\S+)$', b, re.M))
        if kv.get('name') != SCREEN:
            continue
        tiles = {(int(tx), int(ty)): int(mid) for mid, tx, ty in
                 re.findall(r'mapId: (\d+)\s+tileX: (\d+)\s+tileY: (\d+)', b)}
        try:
            return {'x': int(kv['originX']), 'y': int(kv['originY']), 'z': int(kv['originZ']),
                    'w': int(kv['mapWidth']), 'h': int(kv['mapHeight']), 'facing': kv.get('facing'), 'tiles': tiles}
        except (KeyError, ValueError):
            return None
    return None


def mirror_back(st):
    """墙背面的「镜像」:每一格放一个普通画框(朝南、看不见边框、拿不下来、打不坏),里面是和正面【同一个编号】的地图,左右对调
    (从背面看,左手边是 x 小的那头)。插件按地图编号发画面,所以正面每收到一帧,背面自动是同一帧;不多占网速/CPU。
    声音从屏幕中心发出,两边都听得到。插件不知道这些画框,不会去动它们。
    已经对的格子不动;缺的/编号不对的/多出来的重挂。返回 True = 背面全对。"""
    sc = front_screen()
    if not sc or sc['facing'] != 'SOUTH' or len(sc['tiles']) != sc['w'] * sc['h']:
        save_status(st, '背面:读不懂插件里正面屏幕的记录,这次不挂背面')
        return False
    xr, yb, wall = sc['x'], sc['y'], sc['z']                  # 正面看是左下角 = x 最大、y 最小
    xl, yt = xr - (sc['w'] - 1), yb + sc['h'] - 1
    # 先核一格:正面左上角(x 最大、y 最高)应该是第 0 列第 0 行 —— 对不上说明我对「哪格在哪」的理解错了,不挂
    got = rcon(f'minecraft:data get entity @e[type=item_frame,x={xr},y={yt},z={wall - 1},dx=0,dy=0,dz=0,limit=1] Item.components."minecraft:map_id"')
    if not got.endswith(f': {sc["tiles"][(0, 0)]}'):
        save_status(st, f'背面:正面左上角画框的地图编号和插件记录对不上({got[-40:]}),这次不挂背面')
        return False
    bz = wall + 1
    area = f'x={xl},y={yb},z={bz},dx={sc["w"] - 1},dy={sc["h"] - 1},dz=0'
    whole = rcon(f'minecraft:execute if entity @e[type=item_frame,{area}]')
    redo = []
    for (tx, ty), mid in sorted(sc['tiles'].items()):
        x, y = xl + tx, yt - ty
        cell = f'x={x},y={y},z={bz},dx=0,dy=0,dz=0'
        if whole.endswith(f'count: {len(sc["tiles"])}'):
            got = rcon(f'minecraft:data get entity @e[type=item_frame,{cell},limit=1] Item.components."minecraft:map_id"')
            if got.endswith(f': {mid}'):
                continue
        redo.append((x, y, mid, cell))
    for x, y, mid, cell in redo:
        rcon(f'minecraft:kill @e[type=item_frame,{cell}]')
        rcon(f'minecraft:summon minecraft:item_frame {x} {y} {bz} {{Facing:3b,Fixed:1b,Invulnerable:1b,Invisible:1b,'
             f'Item:{{id:"minecraft:filled_map",count:1,components:{{"minecraft:map_id":{mid}}}}}}}')
    if redo:
        # 万一拆画框掉了东西(地图/画框),捡掉;只认这两种,别的掉落物不碰
        for it in ('filled_map', 'item_frame'):
            rcon(f'minecraft:kill @e[type=item,x={xl - 2},y={yb - 6},z={bz - 1},dx={sc["w"] + 3},dy={sc["h"] + 8},dz=4,nbt={{Item:{{id:"minecraft:{it}"}}}}]')
    # 背面画框前一排看不见的光源(和正面一样),晚上也看得清;只填空气格
    rcon(f'minecraft:fill {xl} {yb} {bz + 1} {xr} {yt} {bz + 1} minecraft:light[level=15] replace minecraft:air')
    bad = []
    for (tx, ty), mid in sorted(sc['tiles'].items()):
        x, y = xl + tx, yt - ty
        cell = f'x={x},y={y},z={bz},dx=0,dy=0,dz=0'
        got = rcon(f'minecraft:data get entity @e[type=item_frame,{cell},limit=1] Item.components."minecraft:map_id"')
        if not got.endswith(f': {mid}'):
            bad.append(f'({x},{y})')
    n = rcon(f'minecraft:execute if entity @e[type=item_frame,{area}]')
    ok = not bad and n.endswith(f'count: {len(sc["tiles"])}')
    if redo or not ok:
        save_status(st, f'背面:重挂了 {len(redo)} 格' + ('' if ok else f';核对没过:{" ".join(bad[:6])} {n[-20:]}'))
    return ok


def screen_status(st, s, start, name):
    lv = live_values(start) if start else {}
    url, sha1 = server_pack()
    st['screen'] = {
        'server': bool(start), 'mounted': name or '', 'enabled': s['enabled'],
        'inHours': in_hours(s), 'checked': int(time.time()),
    }
    rng = cfg_range()
    st['cfg'] = {'fps': s['fps'], 'range': rng, 'liveRange': lv.get('range'),
                 'pendingRestart': bool(start) and lv.get('range') != rng}
    st['audio'] = {'on': s['audio'], 'pack': url.rsplit('/', 1)[-1] if url else '',
                   'pendingRestart': bool(start) and lv.get('packSha1', '') != sha1}


# ---------------- 背景音乐(唱片,数据包 yangcinema 放) ----------------
def music_apply(s, st, start, playing):
    """把背景音乐设置写进游戏的 storage yangcinema:cfg。playing = 屏幕在放、在播放时段里、而且视频原声关着。
    vol = 范围/8:声音传到 2×范围 才消失(走近 range 格开始放,走远渐小);同样的设置这次启动已经写过就不再写。"""
    m = s['music']
    on = bool(m['on'] and m['tracks'] and playing)
    rng = m['range']
    tracks = ','.join(f"{{s:'minecraft:music_disc.{t['id']}',t:{int(t['sec'] * 20) + 40}}}" for t in m['tracks'])
    snbt = f"{{on:{1 if on else 0}b,range:{rng},vol:{rng / 8:.1f}f,n:{len(m['tracks'])},tracks:[{tracks}]}}"
    key = hashlib.sha1(f'{start}|{snbt}'.encode()).hexdigest()
    if read_text(ST + '/music') == key:
        return
    out = rcon(f'data merge storage yangcinema:cfg {snbt}')
    if 'Modified' not in out and 'Nothing changed' not in out:   # 「本来就是这样」也算写好了
        save_status(st, f'背景音乐设置没写进游戏:{out[:100]}')
        return
    if not on:                                                # 关掉时,正在听的人也停下(只停唱片,别把视频原声也停了 —— 两个都是「唱片」类声音)
        for t in m['tracks']:
            rcon(f'execute as @a[x=8,y=70,z=45,distance=..{rng * 2 + 16}] run stopsound @s record minecraft:music_disc.{t["id"]}')
        rcon('scoreboard players reset @a ycm_t')
    write_text(ST + '/music', key)
    st['music'] = {'on': on, 'n': len(m['tracks']), 'range': rng}
    why = '' if on else ('(后台关着)' if not m['on'] else '(没选曲目)' if not m['tracks']
                         else '(视频原声开着)' if s['audio'] else '(大屏没在放或不在播放时段)')
    save_status(st, f'背景音乐:{"开" if on else "关"}{why},{len(m["tracks"])} 首,走近 {rng} 格开始放')


# ---------------- 转码 / 拼片 ----------------
def probe(path, as_mc=True):
    cmd = (AS_MC if as_mc else []) + ['ffprobe', '-v', 'error', '-show_entries',
                                      'stream=codec_type,width,height,codec_name:format=duration', '-of', 'json', path]
    p = subprocess.run(cmd, capture_output=True, text=True, timeout=120)
    if p.returncode != 0:
        raise RuntimeError('认不出这个视频:' + (p.stderr.strip().splitlines() or ['未知原因'])[-1][:120])
    j = json.loads(p.stdout or '{}')
    vs = [x for x in j.get('streams') or [] if x.get('codec_type') == 'video']
    if not vs:
        raise RuntimeError('文件里没有画面(可能是纯音频或者坏文件)')
    v = vs[0]
    dur = float((j.get('format') or {}).get('duration') or 0)
    has_audio = any(x.get('codec_type') == 'audio' for x in j.get('streams') or [])
    return {'w': v.get('width'), 'h': v.get('height'), 'codec': v.get('codec_name'), 'dur': round(dur, 1), 'audio': has_audio}


def transcode(src, out, fit, fps, has_audio, total, st, cid):
    """转成屏幕尺寸 + 每秒 fps 张;声音统一成双声道 44.1k(没有声音的补一条静音),而且和画面一样长 ——
    拼成轮播片时每段的声音都正好接在自己的画面后面,不会越拼越错位。"""
    tmp = out + '.tmp.mp4'
    vf = FITS[fit] + f',setsar=1,fps={fps},format=yuv420p'
    cmd = AS_MC + ['ffmpeg', '-nostdin', '-hide_banner', '-loglevel', 'error', '-y', '-i', src]
    if has_audio:
        cmd += ['-map', '0:v:0', '-map', '0:a:0', '-af', 'aresample=44100,aformat=channel_layouts=stereo,apad']
    else:
        cmd += ['-f', 'lavfi', '-i', 'anullsrc=r=44100:cl=stereo', '-map', '0:v:0', '-map', '1:a:0']
    cmd += ['-shortest', '-sn', '-dn', '-t', str(MAX_DUR), '-vf', vf,
            '-c:v', 'libx264', '-preset', 'veryfast', '-crf', '20', '-profile:v', 'high', '-level', '4.0',
            '-g', str(fps * 2), '-keyint_min', str(fps * 2), '-sc_threshold', '0', '-fps_mode', 'cfr', '-r', str(fps),
            '-video_track_timescale', '20480', '-c:a', 'aac', '-b:a', '128k', '-ar', '44100', '-ac', '2',
            '-threads', '2', '-movflags', '+faststart', '-progress', 'pipe:1', '-nostats', tmp]
    p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    last = 0
    for line in p.stdout:
        if line.startswith('out_time_us=') and total:
            try:
                pct = min(99, int(int(line.split('=')[1]) / 1e6 / min(total, MAX_DUR) * 100))
            except ValueError:
                continue
            if time.time() - last > 3:
                st['clips'].setdefault(cid, {})['pct'] = pct
                save_status(st)
                last = time.time()
    err = p.stderr.read()
    if p.wait() != 0:
        try:
            os.remove(tmp)
        except OSError:
            pass
        raise RuntimeError('转换失败:' + (err.strip().splitlines() or ['未知原因'])[-1][:160])
    os.replace(tmp, out)


def make_thumb(clip, cid, dur):
    tmp = CLIPS + f'/.thumb-{cid}.jpg'
    t = f'{min(15.0, dur * 0.3):.1f}'                     # 片头常是黑的(宣传片就是),取 30% 处
    subprocess.run(AS_MC + ['ffmpeg', '-nostdin', '-loglevel', 'error', '-y', '-ss', t, '-i', clip,
                            '-frames:v', '1', '-vf', 'scale=224:128', '-q:v', '4', tmp], timeout=120)
    if os.path.exists(tmp):
        shutil.copyfile(tmp, THUMBS + f'/{cid}.jpg')
        os.chmod(THUMBS + f'/{cid}.jpg', 0o644)
        os.remove(tmp)


def build_playlist(seq):
    """seq:按顺序(含重复)的单段文件;同样的组合不重拼"""
    h = hashlib.sha1('\n'.join(f'{p}:{os.path.getsize(p)}' for p in seq).encode()).hexdigest()[:10]
    name = f'playlist-{h}.mp4'
    out = os.path.join(MEDIA, name)
    if os.path.exists(out):
        return name
    lst = CLIPS + '/concat.txt'
    with open(lst, 'w', encoding='utf-8') as f:
        for p in seq:
            f.write(f"file '{p}'\n")
    os.chmod(lst, 0o644)
    tmp = os.path.join(MEDIA, f'.{name}.tmp.mp4')
    p = subprocess.run(AS_MC + ['ffmpeg', '-nostdin', '-hide_banner', '-loglevel', 'error', '-y', '-f', 'concat',
                                '-safe', '0', '-i', lst, '-c', 'copy', '-movflags', '+faststart', tmp],
                       capture_output=True, text=True, timeout=1800)
    if p.returncode != 0:
        raise RuntimeError('拼轮播片失败:' + (p.stderr.strip().splitlines() or ['未知原因'])[-1][:160])
    os.replace(tmp, out)
    return name


def clip_path(it, fps):
    return f'{CLIPS}/{it["id"]}-{it["fit"]}-{fps}.mp4'


def regen_once(st):
    s = load_settings()
    fps = s['fps']
    known = {it['id'] for it in s['items']}
    # ① 每段转成屏幕尺寸(换了「画面适配」或「每秒画面数」就重转)
    for it in s['items']:
        cid = it['id']
        src = f'{UPLOADS}/{cid}.src'
        clip = clip_path(it, fps)
        c = st['clips'].setdefault(cid, {})
        if not os.path.exists(src):
            c.update(state='error', err='原文件不见了(上传没完成?)请删掉重新上传')
            continue
        if os.path.exists(clip) and c.get('state') == 'ok' and c.get('key') == f'{it["fit"]}-{fps}':
            if not os.path.exists(f'{THUMBS}/{cid}.jpg'):
                make_thumb(clip, cid, c.get('dur') or 0)      # 缩略图丢了就补一张
            continue
        srcm = int(os.path.getmtime(src))
        if c.get('state') == 'error' and c.get('errKey') == f'{srcm}-{it["fit"]}-{fps}':
            continue                                          # 同一个文件、同样的设置已经失败过,不白转
        try:
            c.update(state='processing', pct=0, err='')
            save_status(st, f'开始处理「{it["title"]}」')
            info = probe(src)
            c['src'] = info
            transcode(src, clip, it['fit'], fps, info['audio'], info['dur'], st, cid)
            d = probe(clip)['dur']
            make_thumb(clip, cid, d)
            c.update(state='ok', dur=d, fit=it['fit'], key=f'{it["fit"]}-{fps}', pct=100, sound=info['audio'],
                     cut=bool(info['dur'] > MAX_DUR + 1))
            save_status(st, f'处理好了「{it["title"]}」:{int(d // 60)} 分 {int(d % 60)} 秒{"" if info["audio"] else "(原片没有声音)"}')
        except Exception as e:
            c.update(state='error', err=str(e)[:200], errKey=f'{srcm}-{it["fit"]}-{fps}')
            save_status(st, f'「{it["title"]}」处理失败:{e}')
    # ② 清掉删掉的、不再用的
    for cid in list(st['clips']):
        if cid not in known:
            st['clips'].pop(cid, None)
    wanted = {os.path.basename(clip_path(it, fps)) for it in s['items']}
    for p in os.listdir(CLIPS):
        if re.match(r'^[0-9a-f]{16}-\w+(-\d+)?\.mp4$', p) and p not in wanted:
            os.remove(os.path.join(CLIPS, p))
    for p in os.listdir(THUMBS):
        if p.endswith('.jpg') and p[:-4] not in known:
            os.remove(os.path.join(THUMBS, p))
    for p in os.listdir(UPLOADS):
        full = os.path.join(UPLOADS, p)
        cid = p.split('.')[0]
        age = time.time() - os.path.getmtime(full)
        if p.endswith('.part') and age > 86400:
            os.remove(full)                                    # 一天都没传完的半截
        elif (p.endswith('.src') or p.endswith('.json')) and cid not in known and age > 3600:
            os.remove(full)                                    # 后台删掉的(留 1 小时防误删刚传完的)
    # ③ 按顺序拼成一条
    seq = []
    for it in s['items']:
        c = st['clips'].get(it['id'], {})
        if it['enabled'] and c.get('state') == 'ok':
            seq += [clip_path(it, fps)] * it['repeat']
    if seq:
        try:
            name = build_playlist(seq)
            if read_text(ST + '/current') != name:
                write_text(ST + '/current', name)
                tot = sum(st['clips'][it['id']]['dur'] * it['repeat'] for it in s['items']
                          if it['enabled'] and st['clips'].get(it['id'], {}).get('state') == 'ok')
                st['playlist'] = {'file': name, 'dur': round(tot, 1), 'count': len(seq), 'built': int(time.time())}
                save_status(st, f'轮播片拼好:{len(seq)} 段,共 {int(tot // 60)} 分 {int(tot % 60)} 秒')
        except Exception as e:
            save_status(st, str(e))
    else:
        if read_text(ST + '/current'):
            write_text(ST + '/current', '')
        st['playlist'] = {'file': '', 'dur': 0, 'count': 0, 'built': int(time.time())}
    # ④ 收画面范围(要重启才生效)
    if cfg_apply_range(s['range']):
        lv = read_json(ST + '/live.json', {})
        if lv.get('range') == s['range']:
            save_status(st, f'收画面范围 {s["range"]} 格:和现在实际生效的一样,不用重启')
        else:
            save_status(st, f'收画面范围 {s["range"]} 格已写入,要重启服务器才生效')
    return s


def cleanup(keep_names):
    """删掉不再用的轮播片、插件的声音缓存、旧的进服声音包(正在用的、server.properties 里写的、这次启动生效的都留着)"""
    if keep_names is None:
        return
    keep_ids = {video_id(n) for n in keep_names if n}
    for p in os.listdir(MEDIA):
        if re.match(r'^playlist-[0-9a-f]{10}\.mp4$', p) and p not in keep_names:
            os.remove(os.path.join(MEDIA, p))
    for p in os.listdir(MCC):
        m = re.match(r'^mcc_audio_(playlist_[0-9a-f]{10}_mp4)\.zip$', p)
        if m and m.group(1) not in keep_ids:
            os.remove(os.path.join(MCC, p))
    adir = os.path.join(MCC, 'audio')
    if os.path.isdir(adir):
        for p in os.listdir(adir):
            m = re.match(r'^(playlist_[0-9a-f]{10}_mp4)_', p)
            if m and m.group(1) not in keep_ids:
                shutil.rmtree(os.path.join(adir, p), ignore_errors=True)
    keep_packs = {server_pack()[0].rsplit('/', 1)[-1]}
    lv = read_json(ST + '/live.json', {})
    if lv.get('packSha1'):
        keep_packs.add(f'yangcinema-{lv["packSha1"][:12]}.zip')
    if os.path.isdir(PACK_DIR):
        for p in os.listdir(PACK_DIR):
            if p.startswith('yangcinema-') and p not in keep_packs:
                os.remove(os.path.join(PACK_DIR, p))


# ---------------- 两个入口 ----------------
def cmd_tick():
    lk = open(LOCK, 'w')
    try:
        fcntl.flock(lk, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        return                                                # 正在转码/换片,这轮不碰
    st = load_status()
    s = load_settings()
    if str(s['rev']) != read_text(ST + '/rev'):
        # 后台保存时 regen 正好在忙,那次通知被吞了 → 补叫一次(regen 自己会处理到最新版本)
        subprocess.run(['systemctl', 'start', '--no-block', 'mc-cinema-regen.service'])
    start = server_start()
    name = reconcile(s, st, start) if start else None
    if name and read_text(ST + '/back') != str(start):         # 每次服务器启动后核一遍背面(平时不问,省得日志刷屏)
        if mirror_back(st):
            write_text(ST + '/back', str(start))
    if start:
        music_apply(s, st, start, bool(name) and in_hours(s) and not s['audio'])
    screen_status(st, s, start, name)
    save_status(st)


def cmd_regen():
    lk = open(LOCK, 'w')
    fcntl.flock(lk, fcntl.LOCK_EX)
    st = load_status()
    st['busy'] = True
    save_status(st)
    done_rev = None
    for _ in range(5):                                        # 处理中又保存了一次 → 再来一轮
        s = load_settings()
        if s['rev'] == done_rev:
            break
        s = regen_once(st)
        done_rev = s['rev']
        write_text(ST + '/rev', str(done_rev))
    start = server_start()
    name = reconcile(s, st, start) if start else None
    if name and mirror_back(st):
        write_text(ST + '/back', str(start))
    if start:
        update_login_pack(name or want_name(s), s['audio'], st)
        music_apply(s, st, start, bool(name) and in_hours(s) and not s['audio'])
    st['busy'] = False                                        # 屏幕换好了才算忙完(后台页面靠这个停止自动刷新)
    ok, state, video = mcc_info() if start else (True, None, None)
    cleanup({read_text(ST + '/current'), video} if ok else None)
    screen_status(st, s, start, name)
    save_status(st)


if __name__ == '__main__':
    os.makedirs(CLIPS, exist_ok=True)
    if len(sys.argv) > 2 and sys.argv[1] == 'loginpack':        # 手动:mc-cinema loginpack a.zip b.zip ...
        n, h, k = build_login_pack(sys.argv[2:])
        print('进服声音包', n, h, k, '段声音 →', set_server_pack(n, h), '(重启后生效)')
        sys.exit(0)
    {'tick': cmd_tick, 'regen': cmd_regen}.get(sys.argv[1] if len(sys.argv) > 1 else '', lambda: sys.exit('用法:mc-cinema tick|regen'))()
